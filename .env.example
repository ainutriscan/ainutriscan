# ─────────────────────────────────────────────
# AI NutriScan — Environment Variables Example
# Copy this file to .env and fill in your values
# Never commit your actual .env file
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Auth (NextAuth.js) ────────────────────────
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nutriscan
REDIS_URL=redis://localhost:6379

# ── AI / ML Model ─────────────────────────────
AI_MODEL_ENDPOINT=https://your-model-endpoint.example.com
AI_MODEL_API_KEY=your_model_api_key_here
AI_MODEL_VERSION=v2

# ── Storage (AWS S3) ──────────────────────────
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=nutriscan-uploads
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# ── Analytics (optional) ──────────────────────
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Email (optional) ──────────────────────────
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=hello@nutriscan.ai

# ── Blockchain / Token (optional) ─────────────
RPC_ENDPOINT=https://your-rpc-endpoint.example.com
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
